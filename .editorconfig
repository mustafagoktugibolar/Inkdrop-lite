root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
end_of_line = crlf

[*.csproj]
end_of_line = crlf

[*.slnx]
end_of_line = crlf

[*.json]
end_of_line = crlf

[*.jsonc]
end_of_line = crlf

[*.md]
end_of_line = crlf

[*.yml]
end_of_line = crlf

[*.yaml]
end_of_line = crlf

[Dockerfile]
end_of_line = lf
